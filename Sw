<!doctype html>
<script>
var ia = null;
var buf = null;

self.addEventListener('message', function(e) {
    if (e.data.cmd === 'init') {
        ia = new Int32Array(e.data.sab);
        buf = e.data.buf;
        // Signal ready
        Atomics.store(ia, 0, 1);
        Atomics.notify(ia, 0);
    }
    if (e.data.cmd === 'hammer') {
        // Wait for signal
        Atomics.wait(ia, 0, 1);
        // Hammer simultaneously with main thread
        for (var i = 0; i < 10000; i++) {
            try { buf.resize(i % 2 ? 65536 : 256); } catch(x) {}
        }
    }
});
</script>
