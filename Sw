<!doctype html>
<script>
self.addEventListener('message', function(e) {
    if (e.data.cmd === 'hammer') {
        var buf = e.data.buf;
        var ia = new Int32Array(e.data.sab);
        
        // Signal ready
        Atomics.store(ia, 0, 1);
        
        // Hammer simultaneously
        for (var i = 0; i < 10000; i++) {
            try { buf.resize(i % 2 ? 65536 : 256); } catch(x) {}
        }
    }
});
</script>
